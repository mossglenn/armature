# The public face of a hosted instance (docker-compose.yml, profile `public`).
#
# ARMATURE_SITE is the address Caddy answers for. A domain (demo.example.org)
# gets a certificate from Let's Encrypt automatically, which needs ports 80 and
# 443 open and the domain's DNS pointing at this machine. `:80` serves plain
# HTTP for any address, for a rehearsal without a domain.
#
# Only the viewer is behind it. The hub is never proxied: its `header` identity
# resolver trusts the caller (ADR-0032), so it stays on the private network until
# an authenticating resolver exists: `oidc`, specified in ADR-0067 (Proposed; its
# Host and Origin checks built 2026-10-30; docs/deployment.md).
{$ARMATURE_SITE} {
	encode zstd gzip
	reverse_proxy viewer:3000
}

# Other sites served from this server, one file each in docker/sites/ (mounted
# read-only at /etc/caddy/sites): a client deployed beside the instance names its
# own domain and container there, so this file never names a plugin. A pattern
# that matches no file imports nothing.
import /etc/caddy/sites/*.caddy
