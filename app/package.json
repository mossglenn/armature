{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "sync:terminusdb-docs": "node ../scripts/sync-terminusdb-docs.js",
    "test": "vitest run",
    "build:hub": "esbuild server.ts --bundle --platform=node --format=esm --target=node22 --sourcemap --outfile=dist/server.mjs --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\"",
    "start:hub": "node dist/server.mjs"
  },
  "dependencies": {
    "@armature/types": "0.1.0",
    "@hono/node-server": "2.1.3",
    "@hono/vercel": "1.0.0",
    "hono": "4.13.13",
    "next": "16.1.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@armature/client": "0.1.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "esbuild": "0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "5.0.3"
  }
}
