{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Armature Spike",
  "version": "0.0.1",
  "identifier": "com.mossglenn.armature.spike",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Armature (sidecar spike)",
        "width": 640,
        "height": 440
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "externalBin": ["binaries/armature-node"],
    "resources": {
      "../core/core.mjs": "core/core.mjs"
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "hardenedRuntime": true,
      "entitlements": "entitlements.plist"
    }
  }
}
